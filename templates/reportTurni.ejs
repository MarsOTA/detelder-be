<!DOCTYPE html>
<html lang="it">

<head>
    <meta charset="UTF-8" />
    <title>Calendario del giorno</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            margin: 40px;
            color: #000;
        }

        /* HEADER */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            margin-bottom: 40px;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: bold;
            font-size: 20px;
        }

        .logo img {
            width: 150px;
            /* dimensione fissa più affidabile */
            height: auto;
        }

        .page-title {
            font-size: 18px;
            font-weight: 800;
            letter-spacing: -0.01em;
        }

        /* DATA */
        .date-container {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 30px;
        }

        .day-number {
            font-size: 44px;
            font-weight: 800;
            line-height: 1;
        }

        .date-text {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .month-year {
            font-size: 16px;
            font-weight: 800;
            letter-spacing: 0.02em;
            text-transform: uppercase;
        }

        .weekday {
            font-size: 13px;
            font-weight: 400;
            letter-spacing: 0.01em;
            text-transform: none;
            opacity: 0.9;
        }

        /* TABELLA */
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
            font-size: 14px;
        }

        th,
        td {
            border: 1px solid #ccc;
            padding: 12px 10px;
            text-align: left;
            vertical-align: middle;
        }

        th {
            font-weight: 700;
            background-color: #fff;
        }

        td {
            background-color: #fff;
        }

        .icon-cell {
            width: 40px;
            text-align: center;
        }

        .icon {
            font-size: 18px;
        }

        @page {
            size: A4 landscape;
            margin: 7mm;
        }
    </style>
</head>

<body>
    <!-- HEADER -->
    <div class="header">
        <span class="page-title">Calendario del giorno</span>

        <div class="logo">
            <img src="data:image/png;base64,<%= data.logoBase64 %>" />
        </div>
    </div>

    <% data.giorni.forEach(giorno=> { %>

        <!-- DATA -->
        <div class="date-container">
            <div class="day-number">
                <%= giorno.data.day %>
            </div>

            <div class="date-text">
                <div class="month-year">
                    <%= giorno.data.month %>
                        <%= giorno.data.year %>
                </div>
                <div class="weekday">
                    <%= giorno.data.weekday %>
                </div>
            </div>
        </div>

        <!-- TABELLA -->
        <table>
            <thead>
                <tr>
                    <!--  <th class="icon-cell"></th> -->
                    <th>Da</th>
                    <th>A</th>
                    <th>Cliente</th>
                    <th>Brand</th>
                    <th>Indirizzo</th>
                    <th>Attività</th>
                    <th>Operatore</th>
                    <th>Cell.</th>
                </tr>
            </thead>

            <tbody>
                <% giorno.turni.forEach(item=> { %>
                    <tr>
                        <!--  <td class="icon-cell"><span></span></td> -->
                        <td>
                            <%= item.da %>
                        </td>
                        <td>
                            <%= item.a %>
                        </td>
                        <td>
                            <%= item.cliente %>
                        </td>
                        <td>
                            <%= item.brand %>
                        </td>
                        <td>
                            <%= item.indirizzo %>
                        </td>
                        <td>
                            <%= item.attivita %>
                        </td>
                        <td>
                            <%= item.operatore %>
                        </td>
                        <td>
                            <%= item.telefono %>
                        </td>
                    </tr>
                    <% }) %>
            </tbody>
        </table>

        <!-- separatore pagina -->
        <div style="page-break-after: always;"></div>
        <% }) %>

</body>


</html>