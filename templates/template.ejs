<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <title>PDF Template</title>
  <style>
    body { font-family: Arial, sans-serif; padding: 20px; }
    h1 { color: #333; }
    p { margin: 5px 0; }
  </style>
</head>
<body>
  <h1>PDF generato da EJS + Puppeteer</h1>
  <p>Nome: <%= data.name %></p>
  <p>Email: <%= data.email %></p>
  <p>Telefono: <%= data.telefono %></p>
  <p>Indirizzo: <%= data.indirizzo %></p>
</body>
</html>
